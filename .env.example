# Copy to .env and fill in:  cp .env.example .env
# docker compose reads .env automatically. Never commit .env.

# --- MySQL ---
DB_NAME=familymap
DB_USER=familymap
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# Hosted deploys only: a full JDBC URL replaces DB_HOST/DB_PORT/DB_NAME (see docs/DEPLOY.md).
# DB_URL=jdbc:mysql://host:3306/familymap?sslMode=REQUIRED&serverTimezone=UTC

# --- JWT ---
# REQUIRED. Base64 HMAC key of at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
# "*" for local dev. In production, a comma-separated list such as https://app.example.com
CORS_ALLOWED_ORIGINS=*

# Push notifications (step 6) via Expo's push service. Set false to keep alerts in-app only.
PUSH_ENABLED=true
# Only needed if "Enhanced push security" is on for your Expo project.
EXPO_ACCESS_TOKEN=

# Data retention (step 7). Location points older than this are deleted hourly.
RETENTION_LOCATIONS=7d
RETENTION_SOS=30d

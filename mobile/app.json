{
  "expo": {
    "name": "FamilyMap",
    "slug": "familymap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.familymap.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F0FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.familymap.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FamilyMap shows your location to the family circles you joined. You can pause any time.",
          "locationAlwaysAndWhenInUsePermission": "Lets your family circles see where you are even when FamilyMap is closed. You can pause any time.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "scheme": "familymap",
    "experiments": {
      "typedRoutes": true
    }
  }
}
